{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "outputDirectory": "frontend",
    "cleanUrls": true,
    "rewrites": [
        { "source": "/privacy", "destination": "/pages/privacy" },
        { "source": "/terms", "destination": "/pages/terms" }
    ],
    "redirects": [
        { "source": "/og.jpg", "destination": "/img/og.jpg", "permanent": true },
        { "source": "/favicon.svg", "destination": "/img/favicon.svg", "permanent": true }
    ],
    "headers": [
        {
            "source": "/(.*)\\.(css|js|png|jpg|svg)",
            "headers": [{ "key": "cache-control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
        },
        {
            "source": "/(.*)",
            "headers": [
                { "key": "x-content-type-options", "value": "nosniff" },
                { "key": "referrer-policy", "value": "strict-origin-when-cross-origin" }
            ]
        }
    ]
}
